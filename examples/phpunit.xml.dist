<?xml version="1.0" encoding="UTF-8"?>
<phpunit
  bootstrap="vendor/autoload.php"
  cacheDirectory=".phpunit.cache"
  colors="true"
>
  <testsuites>
    <testsuite name="Code">
      <directory>tests/Code</directory>
    </testsuite>
    <testsuite name="Browser">
      <directory>tests/Browser</directory>
    </testsuite>
  </testsuites>
</phpunit>
