{
  "name": "crosspeak/wp-pest",
  "description": "Pest plugin and tooling for testing WordPress sites and plugins.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "pestphp/pest": "^4.0"
  },
  "require-dev": {
    "laravel/pint": "^1.29"
  },
  "suggest": {
    "pestphp/pest-plugin-browser": "Required when running browser tests."
  },
  "autoload": {
    "psr-4": {
      "CrossPeak\\WpPest\\": "src/"
    },
    "files": [
      "src/Runtime/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/wp-pest"
  ],
  "scripts": {
    "test": "pest",
    "format": "pint"
  },
  "extra": {
    "pest": {
      "plugins": [
        "CrossPeak\\WpPest\\PestPlugin"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
