# EditorConfig is awesome: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Set default charset
[*.{js,php,scss,sass}]
charset = utf-8

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[README.md]
indent_style = space
indent_size = 4
